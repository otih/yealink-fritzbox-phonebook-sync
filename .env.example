# Fritzbox TR-064 connection
FB_HOST=fritz.box
FB_PORT=49000
FB_USER=
FB_PASSWORD=

# Which phonebook IDs to sync:
#   Single ID (e.g. 1):      Only that phonebook appears — direct access, no selection menu
#   Multiple IDs (e.g. 0,1): Each appears as a separate selectable entry in the phone's menu
#   Empty (unset):            All phonebooks are auto-detected and listed individually
# Empty phonebooks (only internal numbers) are hidden automatically.
FB_PHONEBOOK_ID=

# Server settings
SYNC_LISTEN_PORT=8080
SYNC_REFRESH_INTERVAL=3600

# The URL the Yealink phone will use to reach this server.
# Must be reachable from the phone's network (NOT localhost or 0.0.0.0).
# Examples:
#   http://192.168.1.50:8080     (direct IP)
#   http://phonebook.lan:8080    (hostname)
SYNC_SERVER_URL=

# HTTP Basic Auth — protects the phonebook from unauthorized access.
# Set both to enable auth. Leave empty for no auth (NOT recommended).
# On the Yealink phone, embed credentials in the Remote URL:
#   http://phonebook:mypassword@<server-ip>:8080/menu.xml
SYNC_AUTH_USER=
SYNC_AUTH_PASSWORD=

# Optional: only these IPs/CIDR ranges may access the phonebook.
# Empty (default) = allow all. Example: 192.168.1.0/24,10.0.0.5
SYNC_ALLOWED_IPS=

# Log level for debugging: DEBUG, INFO (default), WARNING, ERROR, CRITICAL
SYNC_LOG_LEVEL=

# Log format: text (default) or json (for log aggregation)
SYNC_LOG_FORMAT=

# Optional: persist the phonebook state across restarts.
# Empty (default) = in-memory only (previous behavior).
# When set, the state is saved after every successful sync and restored
# on startup — bridges restarts while the Fritzbox is unreachable.
# Docker: mount a writable volume at this path (the container root fs is read-only).
SYNC_CACHE_DIR=
